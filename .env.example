# ============================================================
# Successor Web3 Support - Environment Configuration
# ============================================================

# AI Provider Selection: 'none' | 'gemini' | 'openai'
# Default is 'none', which utilizes the built-in offline knowledge engine
# with 100% functionality and no API keys required!
VITE_AI_PROVIDER=none

# Google Gemini API Key (Optional)
# Get your key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# OpenAI API Key (Optional)
# Get your key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Application Port (Optional)
PORT=5173
